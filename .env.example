# GEMINI_API_KEY: Optional AI key if Gemini services are later enabled.
GEMINI_API_KEY=""

# APP_URL: Hosted URL for callbacks and self-referential links.
APP_URL="http://localhost:3000"

# TREM_SESSION_SECRET: Server-side secret for signing session/webhook payloads in sandbox mode.
TREM_SESSION_SECRET=""

# TREM_WEBHOOK_SECRET: HMAC-SHA256 secret used to verify payment gateway webhooks.
TREM_WEBHOOK_SECRET=""

# TREM_ADMIN_PASSCODE: Optional server-side passcode for platform administrator sign-in.
# If left unset, an inline first-run admin setup form is available once on /admin.
TREM_ADMIN_PASSCODE=""
